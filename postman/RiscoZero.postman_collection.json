            "body": {
              "mode": "raw",
              "raw": "{\n  \"setor\": \"Producao\",\n  \"turno\": \"Noite\",\n  \"estresse\": 4,\n  \"sono\": 2,\n  \"carga_trabalho\": 5,\n  \"ambiente_fisico\": 2,\n  \"comentario\": \"Enviado pelo Postman\"\n}"
